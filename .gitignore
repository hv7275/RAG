# Audio files - keep folder, ignore contents
audios/*
!audios/.gitkeep

# Chunked text files - keep folder, ignore contents
chunks/*
!chunks/.gitkeep

# JSON output files - keep folder, ignore contents
json_output/*
!json_output/.gitkeep

# Video files - keep folder, ignore contents
Videos/*
!Videos/.gitkeep

# Transcript files - keep folder, ignore contents
transcripts/*
!transcripts/.gitkeep

# Python virtual environment
venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# IDE settings
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Embeddings and vector index files (do not track large artifact files)
embeddings.npy
embeddings.parquet
vector_index.faiss
# catch common variations/names
*.faiss
*.index
*.npy
*.parquet